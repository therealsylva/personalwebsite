{
  "version": 2,
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "/sylva",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/sylva",
